# Copy this file to .env for local development. Never commit the real .env.
DB_HOST=localhost
DB_PORT=5432
DB_NAME=podcast_db
DB_USER=postgres
DB_PASS=replace-with-a-random-database-password

# Use at least 32 random characters for each secret. The backend and AI
# service must use the same AI_SERVICE_SECRET value.
JWT_SECRET=replace-with-at-least-32-random-characters
AI_SERVICE_SECRET=replace-with-at-least-32-random-characters
AI_SERVICE_URL=http://localhost:8001

# Optional: external podcast recommendations are disabled when empty.
LISTEN_NOTES_API_KEY=
