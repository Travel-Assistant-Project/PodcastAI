# Copy this file to .env for local development. Never commit the real .env.
# This value must match the backend's AI_SERVICE_SECRET.
AI_SERVICE_SECRET=replace-with-at-least-32-random-characters

# Keep mock modes enabled to run without third-party API keys.
MOCK_NEWS=true
MOCK_SCRIPT=true
MOCK_TTS=true

NEWS_API_KEY=
OPENROUTER_API_KEY=
ELEVENLABS_API_KEY=

PUBLIC_AUDIO_BASE_URL=http://localhost:5192/podcasts
USE_FIREBASE_STORAGE=false
FIREBASE_CREDENTIALS_PATH=
FIREBASE_STORAGE_BUCKET=
